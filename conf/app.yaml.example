# 基础配置
app_name: "定时任务管理平台"
desc: "定时任务管理平台"
debug: true # gin debug开关
env: dev # 可选 dev test pre prod
http_port: 8083

metrics: false # 是否开启系统监控
metrics_dt: 10 # 系统监控间隔

# asynq 调度引擎(复用主redis)
asynq:
  job_queue: cron_job # 业务 job:exec 队列(与 worker.yaml 保持一致)
  strategy_queue: dbstrategy # db_strategy 策略任务(ttl/retry)队列(与 worker.yaml 保持一致)

# 预定义告警机器人群(任务 alarm 中 type=ding_alarm 按 name 引用, app 侧供下拉枚举)
ding_robots:
  - name: 运维告警群
    webhook: 'https://oapi.dingtalk.com/robot/send?access_token=xxx'
    secret: 'SECxxx'

# 主数据库
mysql:
  debug: true
  dsn: 'root:123123@tcp(mysql-serv:3306)/bs?charset=utf8&parseTime=True&loc=Local'
  maxIdleConns: 10
  maxOpenConns: 100
  connMaxLifetime: 6

#主redis
redis: 
  addr: redis-serv:6379
  db: 0
  pwd: ''
  pool_size: 30
  max_reties: 3
  idle_timeout: 1000

# 日志配置
log:
  type: stdout #可选 file stdout
  level: DEBUG 
  path: "./logs/log.log"
  max_size: 32
  max_age: 30
  max_backups: 300

