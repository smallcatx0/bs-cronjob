# 基础配置
app_name: "定时任务管理平台-worker"
desc: "定时任务消费端(asynq consumer)"

metrics: false # 是否开启系统监控
metrics_dt: 10 # 系统监控间隔

# asynq 消费端(复用主redis)
asynq:
  job_queue: cron_job # 业务 job:exec 队列
  strategy_queue: dbstrategy # db_strategy 策略任务(ttl/retry)队列
  concurrency: 10
  # queues: [cron_job, dbstrategy] # 消费监听队列, 按先后顺序降权; 不填则默认两队列且业务优先
  # 拆分 worker 时只填其一即可, 如只消费策略: queues: [dbstrategy]

# shell 任务白名单(脚本或可执行程序, 基名或全路径)
shell:
  whitelist:
    - echo
    # - /data/scripts/backup.sh

# 主数据库
mysql:
  debug: true
  dsn: 'root:123123@tcp(mysql-serv:13306)/bs?charset=utf8&parseTime=True&loc=Local'
  maxIdleConns: 10
  maxOpenConns: 100
  connMaxLifetime: 6

#主redis
redis: 
  addr: redis-serv:6379
  db: 0
  pwd: ''
  pool_size: 30
  max_reties: 3
  idle_timeout: 1000

# 日志配置
log:
  type: file #可选 file stdout
  level: DEBUG 
  path: "./logs/log.log"
  max_size: 32
  max_age: 30
  max_backups: 300
